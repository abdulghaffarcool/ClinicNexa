@using ClinicNexa.Web.Models

@{
    ViewData["Title"] = "My Appointments";

    var upcoming = ViewBag.Upcoming as List<Appointment>
                   ?? new List<Appointment>();

    var history = ViewBag.History as List<Appointment>
                  ?? new List<Appointment>();
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="cn-hero rounded-4 p-4 p-lg-5 mb-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge rounded-pill bg-white text-primary mb-3">
                    <i class="bi bi-heart-pulse me-1"></i>
                    Doctor Portal
                </span>

                <h2 class="fw-bold mb-2">My Appointments</h2>

                <p class="mb-0 opacity-75">
                    Review patient bookings and manage your appointment schedule.
                </p>
            </div>

            <div class="rounded-3 bg-white bg-opacity-25
                        p-3 text-center align-self-start">
                <i class="bi bi-calendar2-check fs-1"></i>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6">
            <div class="cn-card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-calendar-event fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Upcoming Appointments</div>
                        <h3 class="fw-bold mb-0">@upcoming.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6">
            <div class="cn-card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Appointment History</div>
                        <h3 class="fw-bold mb-0">@history.Count</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="cn-card p-3 p-lg-4">

        <ul class="nav nav-tabs mb-4" id="appointmentTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active"
                        id="upcoming-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#upcoming"
                        type="button"
                        role="tab"
                        aria-controls="upcoming"
                        aria-selected="true">
                    <i class="bi bi-calendar-event me-1"></i>
                    Upcoming
                    <span class="badge rounded-pill bg-primary ms-1">
                        @upcoming.Count
                    </span>
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="history-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#history"
                        type="button"
                        role="tab"
                        aria-controls="history"
                        aria-selected="false">
                    <i class="bi bi-clock-history me-1"></i>
                    History
                    <span class="badge rounded-pill bg-secondary ms-1">
                        @history.Count
                    </span>
                </button>
            </li>
        </ul>

        <div class="tab-content">

            <!-- Upcoming Appointments -->
            <div class="tab-pane fade show active"
                 id="upcoming"
                 role="tabpanel"
                 aria-labelledby="upcoming-tab">

                @if (!upcoming.Any())
                {
                    <div class="text-center py-5">
                        <div class="rounded-circle bg-primary bg-opacity-10
                                        text-primary d-inline-flex align-items-center
                                        justify-content-center mb-3"
                             style="width: 80px; height: 80px;">
                            <i class="bi bi-calendar-x fs-1"></i>
                        </div>

                        <h5 class="fw-bold">No upcoming appointments</h5>

                        <p class="cn-muted mb-0">
                            New patient appointments will appear here.
                        </p>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var appointment in upcoming)
                        {
                            <div class="col-12 col-xl-6">
                                <div class="cn-card h-100 p-4">

                                    <!-- Patient and Status -->
                                    <div class="d-flex justify-content-between
                                                        align-items-start gap-3 mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-primary
                                                                bg-opacity-10 text-primary
                                                                d-flex align-items-center
                                                                justify-content-center"
                                                 style="width: 52px; height: 52px;">
                                                <i class="bi bi-person fs-4"></i>
                                            </div>

                                            <div>
                                                <h5 class="fw-bold mb-1">
                                                    @appointment.Patient.FirstName
                                                    @appointment.Patient.LastName
                                                </h5>
                                                <span class="cn-muted small">
                                                    Patient
                                                </span>
                                            </div>
                                        </div>

                                        @if (appointment.Status == "Confirmed")
                                        {
                                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Confirmed
                                            </span>
                                        }
                                        else if (appointment.Status == "Pending")
                                        {
                                            <span class="badge rounded-pill bg-warning bg-opacity-25 text-dark px-3 py-2">
                                                <i class="bi bi-hourglass-split me-1"></i>
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                                                @appointment.Status
                                            </span>
                                        }
                                    </div>

                                    <hr class="opacity-25" />

                                    <!-- Appointment Details -->
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="rounded-3 p-3 h-100 bg-body-tertiary">
                                                <div class="cn-muted small mb-2">
                                                    <i class="bi bi-calendar3 me-1"></i>
                                                    Date
                                                </div>
                                                <strong>
                                                    @appointment.AppointmentDate.ToString("MMM dd, yyyy")
                                                </strong>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="rounded-3 p-3 h-100 bg-body-tertiary">
                                                <div class="cn-muted small mb-2">
                                                    <i class="bi bi-clock me-1"></i>
                                                    Time
                                                </div>
                                                <strong>
                                                    @appointment.StartTime.ToString(@"hh\:mm")
                                                    -
                                                    @appointment.EndTime.ToString(@"hh\:mm")
                                                </strong>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(appointment.Reason))
                                    {
                                        <div class="mt-3">
                                            <div class="cn-muted small mb-1">
                                                <i class="bi bi-chat-left-text me-1"></i>
                                                Reason for Visit
                                            </div>
                                            <p class="mb-0">
                                                @appointment.Reason
                                            </p>
                                        </div>
                                    }

                                    <!-- Appointment Actions -->
                                    <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">

                                        @if (appointment.Status == "Pending")
                                        {
                                            <form asp-action="Confirm" method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@appointment.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm rounded-3 px-3">
                                                    <i class="bi bi-check-lg me-1"></i>
                                                    Confirm
                                                </button>
                                            </form>
                                        }

                                        @if (appointment.Status == "Confirmed")
                                        {
                                            <form asp-action="Complete" method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@appointment.Id" />

                                                <button type="submit"
                                                        class="btn btn-gradient btn-sm rounded-3 px-3">
                                                    <i class="bi bi-check2-circle me-1"></i>
                                                    Mark Completed
                                                </button>
                                            </form>
                                        }

                                        @if (appointment.Status == "Pending" ||
                                                                        appointment.Status == "Confirmed")
                                        {
                                            <form asp-action="Cancel"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@appointment.Id" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm rounded-3 px-3">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Appointment History -->
            <div class="tab-pane fade"
                 id="history"
                 role="tabpanel"
                 aria-labelledby="history-tab">

                @if (!history.Any())
                {
                    <div class="text-center py-5">
                        <div class="rounded-circle bg-primary bg-opacity-10
                                        text-primary d-inline-flex align-items-center
                                        justify-content-center mb-3"
                             style="width: 80px; height: 80px;">
                            <i class="bi bi-clock-history fs-1"></i>
                        </div>

                        <h5 class="fw-bold">No appointment history</h5>

                        <p class="cn-muted mb-0">
                            Completed and cancelled appointments will appear here.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="py-3">Patient</th>
                                    <th class="py-3">Date</th>
                                    <th class="py-3">Time</th>
                                    <th class="py-3">Status</th>
                                    <th class="py-3">Reason</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var appointment in history)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-primary
                                                                    bg-opacity-10 text-primary
                                                                    d-flex align-items-center
                                                                    justify-content-center"
                                                     style="width: 38px; height: 38px;">
                                                    <i class="bi bi-person"></i>
                                                </div>

                                                <strong>
                                                    @appointment.Patient.FirstName
                                                    @appointment.Patient.LastName
                                                </strong>
                                            </div>
                                        </td>

                                        <td>
                                            @appointment.AppointmentDate.ToString("MMM dd, yyyy")
                                        </td>

                                        <td>
                                            <span class="text-nowrap">
                                                @appointment.StartTime.ToString(@"hh\:mm")
                                                -
                                                @appointment.EndTime.ToString(@"hh\:mm")
                                            </span>
                                        </td>

                                        <td>
                                            @if (appointment.Status == "Completed")
                                            {
                                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Completed
                                                </span>
                                            }
                                            else if (appointment.Status == "Cancelled")
                                            {
                                                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancelled
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                                                    @appointment.Status
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (string.IsNullOrWhiteSpace(appointment.Reason))
                                            {
                                                <span class="cn-muted">—</span>
                                            }
                                            else
                                            {
                                                @appointment.Reason
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div>
</div>