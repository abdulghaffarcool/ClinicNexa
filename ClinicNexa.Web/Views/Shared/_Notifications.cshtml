<div class="toast-container position-fixed top-0 end-0 p-3"
     style="z-index: 1090;">

    @if (TempData["Success"] is string successMessage)
    {
        <div class="toast text-bg-success border-0"
             role="status"
             aria-live="polite"
             aria-atomic="true"
             data-bs-delay="4000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @successMessage
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"
                        aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="toast text-bg-danger border-0"
             role="alert"
             aria-live="assertive"
             aria-atomic="true"
             data-bs-delay="7000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @errorMessage
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"
                        aria-label="Close"></button>
            </div>
        </div>
    }
</div>