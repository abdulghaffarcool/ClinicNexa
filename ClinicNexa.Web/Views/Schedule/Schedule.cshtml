@using ClinicNexa.Web.Models
@using System.Linq

@model List<ClinicNexa.Web.Models.DoctorSchedule>

@{
    ViewData["Title"] = "My Schedule";
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="cn-hero p-4 p-lg-5 rounded-4 mb-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-4">
            <div>
                <span class="badge rounded-pill bg-white text-primary mb-3">
                    <i class="bi bi-calendar-week me-1"></i>
                    Doctor Portal
                </span>

                <h2 class="fw-bold mb-2">My Schedule</h2>

                <p class="mb-0 opacity-75">
                    Manage your weekly working hours and appointment duration.
                </p>
            </div>

            <a asp-action="AddSchedule"
               class="btn btn-gradient rounded-3 px-4 py-2 flex-shrink-0">
                <i class="bi bi-plus-lg me-2"></i>
                Add Schedule
            </a>
        </div>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="cn-card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Total Schedules</div>
                        <h3 class="fw-bold mb-0">@Model.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="cn-card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Active Schedules</div>
                        <h3 class="fw-bold mb-0">
                            @Model.Count(s => s.IsAvailable)
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="cn-card p-4 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-calendar-x fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Disabled Schedules</div>
                        <h3 class="fw-bold mb-0">
                            @Model.Count(s => !s.IsAvailable)
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="cn-card text-center p-5">
            <div class="rounded-circle bg-primary bg-opacity-10
                            text-primary d-inline-flex align-items-center
                            justify-content-center mb-4"
                 style="width: 84px; height: 84px;">
                <i class="bi bi-calendar2-plus fs-1"></i>
            </div>

            <h4 class="fw-bold mb-2">No schedules configured</h4>

            <p class="cn-muted mx-auto mb-4" style="max-width: 480px;">
                You haven't added any working hours yet. Create a schedule
                so patients can book appointments with you.
            </p>

            <div>
                <a asp-action="AddSchedule"
                   class="btn btn-gradient rounded-3 px-4 py-2">
                    <i class="bi bi-plus-lg me-2"></i>
                    Create Your First Schedule
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Schedule Cards -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h5 class="fw-bold mb-1">Weekly Working Hours</h5>
                <p class="cn-muted small mb-0">
                    Update or disable individual working days.
                </p>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var schedule in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="cn-card h-100 p-4">

                        <!-- Card Header -->
                        <div class="d-flex justify-content-between
                                            align-items-start gap-2 mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 p-3 bg-primary
                                                    bg-opacity-10 text-primary">
                                    <i class="bi bi-calendar-day fs-4"></i>
                                </div>

                                <div>
                                    <h5 class="fw-bold mb-1">
                                        @schedule.DayOfWeek
                                    </h5>
                                    <span class="cn-muted small">
                                        Weekly schedule
                                    </span>
                                </div>
                            </div>

                            @if (schedule.IsAvailable)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                                    Disabled
                                </span>
                            }
                        </div>

                        <!-- Working Hours -->
                        <div class="rounded-3 p-3 mb-3"
                             style="background: var(--bs-tertiary-bg, #f8faff);">
                            <div class="d-flex align-items-center gap-2 cn-muted small mb-2">
                                <i class="bi bi-clock"></i>
                                Working Hours
                            </div>

                            <div class="fw-bold fs-5">
                                @schedule.StartTime.ToString(@"hh\:mm")
                                <i class="bi bi-arrow-right mx-2 text-primary small"></i>
                                @schedule.EndTime.ToString(@"hh\:mm")
                            </div>
                        </div>

                        <!-- Appointment Duration -->
                        <div class="d-flex justify-content-between
                                            align-items-center mb-4">
                            <span class="cn-muted">
                                <i class="bi bi-hourglass-split me-2"></i>
                                Appointment Duration
                            </span>

                            <strong>
                                @schedule.AppointmentDurationMinutes min
                            </strong>
                        </div>

                        <hr class="opacity-25" />

                        <!-- Actions -->
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a asp-action="EditSchedule"
                               asp-route-id="@schedule.Id"
                               class="btn btn-outline-primary btn-sm rounded-3 flex-grow-1">
                                <i class="bi bi-pencil-square me-1"></i>
                                Edit
                            </a>

                            <form asp-action="ToggleSchedule" method="post"
                                  class="flex-grow-1">
                                <input type="hidden"
                                       name="id"
                                       value="@schedule.Id" />

                                <button type="submit"
                                        class="btn btn-outline-secondary btn-sm rounded-3 w-100">
                                    @if (schedule.IsAvailable)
                                    {
                                        <i class="bi bi-pause-circle me-1"></i>
                                        <text>Disable</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-play-circle me-1"></i>
                                        <text>Enable</text>
                                    }
                                </button>
                            </form>

                            <form asp-action="DeleteSchedule"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this schedule?');">
                                <input type="hidden"
                                       name="id"
                                       value="@schedule.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm rounded-3">
                                    <i class="bi bi-trash me-1"></i>
                                    Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>