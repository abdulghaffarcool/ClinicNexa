@model IEnumerable<ClinicNexa.Web.Models.Doctor>

@{
    ViewData["Title"] = "Manage Doctors";
    var doctors = Model?.ToList() ?? new List<ClinicNexa.Web.Models.Doctor>();
    var activeCount = doctors.Count(d => d.IsActive);
    var inactiveCount = doctors.Count - activeCount;
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <span class="badge rounded-pill px-3 py-2 mb-2"
                  style="background: #DBEAFE; color: #1D4ED8;">
                <i class="bi bi-hospital me-1"></i>
                Administration
            </span>

            <h2 class="cn-page-title mb-2">Manage Doctors</h2>
            <p class="cn-muted mb-0">
                View doctor profiles, manage account status, and maintain professional details.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Dashboard"
               class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-2"></i>Dashboard
            </a>

            <a asp-action="CreateDoctor"
               class="btn btn-gradient rounded-3">
                <i class="bi bi-person-plus me-2"></i>Add Doctor
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #DBEAFE; color: #1D4ED8;">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Total Doctors</div>
                        <h3 class="fw-bold mb-0">@doctors.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #D1FAE5; color: #047857;">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Active Doctors</div>
                        <h3 class="fw-bold mb-0">@activeCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #F1F5F9; color: #64748B;">
                        <i class="bi bi-person-dash fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Inactive Doctors</div>
                        <h3 class="fw-bold mb-0">@inactiveCount</h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Doctors Table -->
    <div class="cn-card overflow-hidden">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 p-4 border-bottom">
            <div>
                <h5 class="fw-bold mb-1">Doctor Directory</h5>
                <p class="cn-muted small mb-0">
                    @doctors.Count registered doctor(s)
                </p>
            </div>

            <span class="small cn-muted">
                <i class="bi bi-shield-check me-1"></i>
                Administrative controls
            </span>
        </div>

        @if (doctors.Count == 0)
        {
            <div class="text-center py-5 px-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width: 72px; height: 72px; background: #DBEAFE; color: #1D4ED8;">
                    <i class="bi bi-person-plus fs-2"></i>
                </div>

                <h5 class="fw-bold">No doctors registered yet</h5>
                <p class="cn-muted mb-4">
                    Add your first doctor to start building the clinic directory.
                </p>

                <a asp-action="CreateDoctor"
                   class="btn btn-gradient rounded-3">
                    <i class="bi bi-plus-circle me-2"></i>Add Doctor
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead style="background: #EFF6FF;">
                        <tr>
                            <th class="px-4 py-3 text-nowrap">Doctor</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Specialties</th>
                            <th class="py-3 text-nowrap">Experience</th>
                            <th class="py-3 text-nowrap">Fee (PKR)</th>
                            <th class="py-3">Status</th>
                            <th class="px-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var doctor in doctors)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                             style="width: 42px; height: 42px; background: #DBEAFE; color: #1D4ED8;">
                                            <i class="bi bi-person-badge fs-5"></i>
                                        </div>

                                        <div>
                                            <div class="fw-semibold text-nowrap">
                                                Dr. @doctor.FirstName @doctor.LastName
                                            </div>
                                            <div class="cn-muted small">
                                                Doctor ID: @doctor.Id
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3">
                                    <span class="text-nowrap">
                                        @(doctor.User?.Email ?? "—")
                                    </span>
                                </td>

                                <td class="py-3">
                                    @if (doctor.DoctorSpecialties?.Any() == true)
                                    {
                                        <div class="d-flex flex-wrap gap-1"
                                             style="min-width: 150px;">
                                            @foreach (var ds in doctor.DoctorSpecialties)
                                            {
                                                <span class="badge rounded-pill fw-medium px-2 py-2"
                                                      style="background: #DBEAFE; color: #1E40AF;">
                                                    @ds.Specialty.Name
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="cn-muted small">No specialties</span>
                                    }
                                </td>

                                <td class="py-3 text-nowrap">
                                    @doctor.ExperienceYears years
                                </td>

                                <td class="py-3 text-nowrap fw-semibold">
                                    @doctor.ConsultationFee.ToString("N0")
                                </td>

                                <td class="py-3">
                                    @if (doctor.IsActive)
                                    {
                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background: #D1FAE5; color: #047857;">
                                            <i class="bi bi-check-circle me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background: #F1F5F9; color: #64748B;">
                                            <i class="bi bi-pause-circle me-1"></i>Inactive
                                        </span>
                                    }
                                </td>

                                <td class="px-4 py-3">
                                    <div class="d-flex justify-content-end align-items-center gap-2"
                                         style="min-width: 290px;">

                                        <a asp-action="EditDoctor"
                                           asp-route-id="@doctor.Id"
                                           class="btn btn-sm btn-outline-primary rounded-2"
                                           title="Edit doctor">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>

                                        <a asp-action="ResetPassword"
                                           asp-route-type="Doctor"
                                           asp-route-id="@doctor.Id"
                                           class="btn btn-sm btn-outline-warning rounded-2 text-nowrap"
                                           title="Reset password">
                                            <i class="bi bi-key me-1"></i>Reset Password
                                        </a>

                                        <form asp-action="ToggleDoctor"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@doctor.Id" />

                                            @if (doctor.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger rounded-2"
                                                        title="Disable doctor">
                                                    <i class="bi bi-person-dash me-1"></i>Disable
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success rounded-2"
                                                        title="Activate doctor">
                                                    <i class="bi bi-person-check me-1"></i>Activate
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

        @if (doctors.Count > 0)
        {
            <div class="px-4 py-3 border-top">
                <p class="cn-muted small mb-0">
                    Showing @doctors.Count doctor(s)
                </p>
            </div>
        }
    </div>
</div>