@model ClinicNexa.Web.Models.Patient

@{
    ViewData["Title"] = "Patient Details";

    var appointments = Model.Appointments?
        .OrderByDescending(a => a.AppointmentDate)
        .ToList() ?? new List<ClinicNexa.Web.Models.Appointment>();
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="cn-hero p-4 p-lg-5 mb-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3">

            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="cn-glass rounded-circle p-2">
                        <i class="bi bi-person-vcard fs-4"></i>
                    </span>
                    <span class="text-uppercase small fw-semibold">
                        Patient Management
                    </span>
                </div>

                <h1 class="cn-page-title mb-2">
                    @Model.FirstName @Model.LastName
                </h1>

                <p class="mb-0 cn-muted">
                    Review personal information and appointment history.
                </p>
            </div>

            <a asp-action="Patients"
               class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Back to Patients
            </a>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-calendar2-check fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Total Appointments</div>
                        <h3 class="fw-bold mb-0">@appointments.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Completed</div>
                        <h3 class="fw-bold mb-0">
                            @appointments.Count(a => a.Status == "Completed")
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Confirmed</div>
                        <h3 class="fw-bold mb-0">
                            @appointments.Count(a => a.Status == "Confirmed")
                        </h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <!-- Personal Information -->
        <div class="col-lg-5">
            <div class="cn-card p-4 h-100">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-person-lines-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Personal Information</h5>
                        <p class="cn-muted small mb-0">
                            Patient contact and profile details
                        </p>
                    </div>
                </div>

                <div class="text-center py-3 mb-3 rounded-4"
                     style="background: var(--bs-primary-bg-subtle);">
                    <div class="rounded-circle d-inline-flex align-items-center
                                justify-content-center bg-primary text-white mb-3"
                         style="width: 76px; height: 76px; font-size: 1.5rem;">
                        @Model.FirstName?.FirstOrDefault()@Model.LastName?.FirstOrDefault()
                    </div>

                    <h5 class="fw-bold mb-1">
                        @Model.FirstName @Model.LastName
                    </h5>
                    <p class="cn-muted small mb-0">
                        <i class="bi bi-envelope me-1"></i>
                        @(Model.User?.Email ?? "-")
                    </p>
                </div>

                <dl class="row mb-0">

                    <dt class="col-sm-5 cn-muted fw-medium py-2">Phone</dt>
                    <dd class="col-sm-7 py-2 mb-0">
                        @(Model.Phone ?? "-")
                    </dd>

                    <dt class="col-sm-5 cn-muted fw-medium py-2">Date of Birth</dt>
                    <dd class="col-sm-7 py-2 mb-0">
                        @(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "-")
                    </dd>

                    <dt class="col-sm-5 cn-muted fw-medium py-2">Gender</dt>
                    <dd class="col-sm-7 py-2 mb-0">
                        @(Model.Gender ?? "-")
                    </dd>

                    <dt class="col-sm-5 cn-muted fw-medium py-2">Blood Group</dt>
                    <dd class="col-sm-7 py-2 mb-0">
                        @(Model.BloodGroup ?? "-")
                    </dd>

                    <dt class="col-sm-5 cn-muted fw-medium py-2">Address</dt>
                    <dd class="col-sm-7 py-2 mb-0 text-break">
                        @(Model.Address ?? "-")
                    </dd>

                </dl>
            </div>
        </div>

        <!-- Appointment History -->
        <div class="col-lg-7">
            <div class="cn-card p-4 h-100">

                <div class="d-flex flex-column flex-sm-row
                            justify-content-between align-items-sm-center
                            gap-2 mb-4">
                    <div>
                        <h5 class="fw-bold mb-1">Appointment History</h5>
                        <p class="cn-muted small mb-0">
                            Appointments associated with this patient
                        </p>
                    </div>

                    <span class="badge rounded-pill text-bg-primary px-3 py-2">
                        @appointments.Count appointments
                    </span>
                </div>

                @if (appointments.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x display-5 cn-muted"></i>
                        <h6 class="fw-bold mt-3">No appointments yet</h6>
                        <p class="cn-muted mb-0">
                            This patient has no appointment history.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="text-nowrap">Date</th>
                                    <th>Doctor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var appointment in appointments)
                                {
                                    <tr>
                                        <td class="text-nowrap">
                                            <span class="fw-semibold">
                                                @appointment.AppointmentDate.ToString("dd MMM yyyy")
                                            </span>
                                        </td>

                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="rounded-circle d-inline-flex
                                                                     align-items-center justify-content-center
                                                                     bg-info bg-opacity-10 text-info"
                                                      style="width: 36px; height: 36px;">
                                                    <i class="bi bi-person-badge"></i>
                                                </span>

                                                <span class="fw-medium">
                                                    Dr. @appointment.Doctor.FirstName
                                                    @appointment.Doctor.LastName
                                                </span>
                                            </div>
                                        </td>

                                        <td>
                                            @if (appointment.Status == "Completed")
                                            {
                                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                                    <i class="bi bi-check-circle me-1"></i>Completed
                                                </span>
                                            }
                                            else if (appointment.Status == "Cancelled")
                                            {
                                                <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                                                    <i class="bi bi-x-circle me-1"></i>Cancelled
                                                </span>
                                            }
                                            else if (appointment.Status == "Confirmed")
                                            {
                                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
                                                    <i class="bi bi-check2-circle me-1"></i>Confirmed
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-warning bg-opacity-25 text-dark px-3 py-2">
                                                    @(appointment.Status ?? "Unknown")
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>

    </div>
</div>