@model ClinicNexa.Web.ViewModels.AdminDoctorCreateViewModel

@{
    ViewData["Title"] = "Add Doctor";
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="cn-hero rounded-4 p-4 p-lg-5 mb-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge rounded-pill bg-white text-primary mb-3">
                    <i class="bi bi-shield-check me-1"></i>
                    Administration
                </span>

                <h2 class="fw-bold mb-2">Add Doctor</h2>

                <p class="mb-0 opacity-75">
                    Create a doctor account and configure their professional profile.
                </p>
            </div>

            <a asp-action="Doctors"
               class="btn btn-light rounded-3 px-4 py-2">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Doctors
            </a>
        </div>
    </div>

    <form asp-action="CreateDoctor" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger rounded-3 mb-4">
        </div>

        <div class="row g-4">

            <!-- Main Form -->
            <div class="col-12 col-xl-8">

                <!-- Account Information -->
                <div class="cn-card p-4 p-lg-5 mb-4">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-3 bg-primary bg-opacity-10
                                    text-primary d-flex align-items-center
                                    justify-content-center"
                             style="width: 52px; height: 52px;">
                            <i class="bi bi-person-lock fs-4"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Account Information</h5>
                            <p class="cn-muted small mb-0">
                                Enter the doctor's account and contact details.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label asp-for="FirstName"
                                   class="form-label fw-semibold">
                                First Name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Enter first name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="LastName"
                                   class="form-label fw-semibold">
                                Last Name
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Enter last name" />

                            <span asp-validation-for="LastName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="doctor@example.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Phone"
                                   class="form-label fw-semibold">
                                Phone
                            </label>

                            <input asp-for="Phone"
                                   type="tel"
                                   class="form-control"
                                   placeholder="Enter phone number"
                                   autocomplete="tel" />

                            <span asp-validation-for="Phone"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Initial Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter initial password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                                Confirm Password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <!-- Professional Information -->
                <div class="cn-card p-4 p-lg-5 mb-4">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-3 bg-info bg-opacity-10
                                    text-info d-flex align-items-center
                                    justify-content-center"
                             style="width: 52px; height: 52px;">
                            <i class="bi bi-briefcase-medical fs-4"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Professional Information</h5>
                            <p class="cn-muted small mb-0">
                                Define the doctor's qualifications and services.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-12 col-md-4">
                            <label asp-for="Gender"
                                   class="form-label fw-semibold">
                                Gender
                            </label>

                            <select asp-for="Gender" class="form-select">
                                <option value="">Select gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>

                            <span asp-validation-for="Gender"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Qualification"
                                   class="form-label fw-semibold">
                                Qualification
                            </label>

                            <input asp-for="Qualification"
                                   class="form-control"
                                   placeholder="e.g. MBBS, FCPS" />

                            <span asp-validation-for="Qualification"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="ExperienceYears"
                                   class="form-label fw-semibold">
                                Experience (Years)
                            </label>

                            <input asp-for="ExperienceYears"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="ExperienceYears"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ConsultationFee"
                                   class="form-label fw-semibold">
                                Consultation Fee
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">PKR</span>

                                <input asp-for="ConsultationFee"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="ConsultationFee"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Bio"
                                   class="form-label fw-semibold">
                                Biography
                            </label>

                            <textarea asp-for="Bio"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter a short professional biography"></textarea>

                            <span asp-validation-for="Bio"
                                  class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <!-- Specialties -->
                <div class="cn-card p-4 p-lg-5">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-3 bg-primary bg-opacity-10
                                    text-primary d-flex align-items-center
                                    justify-content-center"
                             style="width: 52px; height: 52px;">
                            <i class="bi bi-heart-pulse fs-4"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Medical Specialties</h5>
                            <p class="cn-muted small mb-0">
                                Select all specialties that apply.
                            </p>
                        </div>
                    </div>

                    @if (Model.Specialties.Any())
                    {
                        <div class="row g-3">
                            @foreach (var specialty in Model.Specialties)
                            {
                                <div class="col-12 col-sm-6 col-lg-4">
                                    <label class="d-flex align-items-center gap-2
                                                          border rounded-3 p-3 h-100
                                                          specialty-option"
                                           for="specialty_@specialty.Id"
                                           style="cursor: pointer;">

                                        <input class="form-check-input mt-0 flex-shrink-0"
                                               type="checkbox"
                                               name="SelectedSpecialtyIds"
                                               value="@specialty.Id"
                                               id="specialty_@specialty.Id"
                                               checked="@specialty.Selected" />

                                        <span class="small fw-medium">
                                            @specialty.Name
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning rounded-3 mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            No specialties have been created yet. Add specialties before assigning them to doctors.
                        </div>
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-12 col-xl-4">

                <div class="cn-card p-4 mb-4">
                    <div class="rounded-3 bg-primary bg-opacity-10
                                text-primary d-inline-flex align-items-center
                                justify-content-center mb-3"
                         style="width: 52px; height: 52px;">
                        <i class="bi bi-clipboard-check fs-4"></i>
                    </div>

                    <h5 class="fw-bold mb-3">Before Creating</h5>

                    <div class="d-flex gap-3 mb-3">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <p class="cn-muted small mb-0">
                            Verify the doctor's name and contact information.
                        </p>
                    </div>

                    <div class="d-flex gap-3 mb-3">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <p class="cn-muted small mb-0">
                            Set a secure initial password and follow your account handover process.
                        </p>
                    </div>

                    <div class="d-flex gap-3">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <p class="cn-muted small mb-0">
                            Confirm qualifications, consultation fee, and specialties.
                        </p>
                    </div>
                </div>

                <div class="rounded-4 p-4 border mb-4"
                     style="background: rgba(6, 182, 212, 0.06); border-color: rgba(6, 182, 212, 0.25) !important;">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-shield-lock text-info me-2"></i>
                        Account Security
                    </h6>

                    <p class="cn-muted small mb-0">
                        Doctor accounts should be created with unique credentials.
                        Avoid sharing initial passwords through insecure channels.
                    </p>
                </div>

                <!-- Form Actions -->
                <div class="cn-card p-4">
                    <h6 class="fw-bold mb-3">Ready to Create?</h6>

                    <p class="cn-muted small mb-4">
                        Review the details before creating the doctor account.
                    </p>

                    <button type="submit"
                            class="btn btn-gradient rounded-3 w-100 py-2 mb-2">
                        <i class="bi bi-person-plus me-2"></i>
                        Create Doctor
                    </button>

                    <a asp-action="Doctors"
                       class="btn btn-outline-secondary rounded-3 w-100 py-2">
                        Cancel
                    </a>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}