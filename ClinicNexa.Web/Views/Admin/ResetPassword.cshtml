@model ClinicNexa.Web.ViewModels.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";

    var backAction = Model.AccountType == "Doctor"
        ? "Doctors"
        : "Patients";
}

<div class="container py-4 py-lg-5">

    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-6 col-xl-5">

            <!-- Page Header -->
            <div class="cn-hero p-4 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="cn-glass rounded-3 p-3">
                        <i class="bi bi-shield-lock fs-3"></i>
                    </div>

                    <div>
                        <h1 class="cn-page-title mb-1">Reset Password</h1>
                        <p class="cn-muted mb-0">
                            Account security management
                        </p>
                    </div>
                </div>

                <p class="cn-muted mb-0">
                    Set a new password for the selected account.
                    The account holder's existing password will be replaced.
                </p>
            </div>

            <!-- Reset Password Card -->
            <div class="cn-card p-4 p-lg-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-circle d-flex align-items-center
                                justify-content-center bg-primary bg-opacity-10
                                text-primary flex-shrink-0"
                         style="width: 52px; height: 52px;">
                        <i class="bi bi-person-lock fs-4"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold mb-1">Account Details</h5>
                        <p class="cn-muted small mb-0">
                            Verify the account before continuing.
                        </p>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Account Type</label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-person-badge"></i>
                        </span>
                        <input class="form-control"
                               value="@Model.AccountType"
                               readonly />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input class="form-control"
                               value="@Model.Email"
                               readonly />
                    </div>
                </div>

                <hr class="my-4" />

                <form asp-action="ResetPassword"
                      asp-route-type="@Model.AccountType"
                      asp-route-id="@Model.EntityId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="type" value="@Model.AccountType" />
                    <input type="hidden" name="id" value="@Model.EntityId" />

                    <input type="hidden" asp-for="AccountType" />
                    <input type="hidden" asp-for="EntityId" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger rounded-3"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword"
                               class="form-label fw-semibold"></label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Enter new password" />
                        </div>

                        <span asp-validation-for="NewPassword"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword"
                               class="form-label fw-semibold"></label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Confirm new password" />
                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info rounded-3 mb-4">
                        <div class="d-flex gap-2">
                            <i class="bi bi-info-circle-fill mt-1"></i>
                            <div>
                                <strong>Password requirements</strong>
                                <p class="small mb-0 mt-1">
                                    The new password must satisfy the application's
                                    ASP.NET Core Identity password policy.
                                </p>
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-gradient w-100 py-2 rounded-pill">
                        <i class="bi bi-key me-2"></i>Reset Password
                    </button>

                    <a asp-action="@backAction"
                       class="btn btn-outline-secondary w-100 rounded-pill mt-2">
                        <i class="bi bi-arrow-left me-2"></i>Back to @backAction
                    </a>

                </form>
            </div>

            <p class="cn-muted small text-center mt-3">
                <i class="bi bi-shield-check me-1"></i>
                Only authorized administrators should reset account passwords.
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}