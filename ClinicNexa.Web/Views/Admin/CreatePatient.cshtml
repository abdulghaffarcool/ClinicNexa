@model ClinicNexa.Web.ViewModels.AdminPatientCreateViewModel

@{
    ViewData["Title"] = "Add Patient";
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-inline-flex align-items-center gap-2 mb-2">
                <span class="badge rounded-pill px-3 py-2"
                      style="background: #DBEAFE; color: #1D4ED8;">
                    <i class="bi bi-person-plus me-1"></i>
                    Patient Management
                </span>
            </div>

            <h2 class="cn-page-title mb-2">Add Patient</h2>
            <p class="cn-muted mb-0">
                Create a patient account and complete their profile information.
            </p>
        </div>

        <a asp-action="Patients" class="btn btn-outline-primary rounded-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Patients
        </a>
    </div>

    <div class="row g-4">

        <!-- Main Form -->
        <div class="col-lg-8">
            <div class="cn-card h-100 p-4 p-lg-5">

                <form asp-action="CreatePatient" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger rounded-3"
                         role="alert"></div>

                    <!-- Account Information -->
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 48px; height: 48px; background: #DBEAFE; color: #1D4ED8;">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Account Information</h5>
                            <p class="cn-muted small mb-0">
                                Patient identity and login credentials.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">
                                First Name
                            </label>
                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Enter first name"
                                   autocomplete="given-name" />
                            <span asp-validation-for="FirstName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">
                                Last Name
                            </label>
                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Enter last name"
                                   autocomplete="family-name" />
                            <span asp-validation-for="LastName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">
                                Email Address
                            </label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="patient@example.com"
                                   autocomplete="email" />
                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">
                                Phone Number
                            </label>
                            <input asp-for="Phone"
                                   type="tel"
                                   class="form-control"
                                   placeholder="Enter phone number"
                                   autocomplete="tel" />
                            <span asp-validation-for="Phone"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">
                                Initial Password
                            </label>
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Set initial password" />
                            <span asp-validation-for="Password"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                Confirm Password
                            </label>
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Confirm password" />
                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Patient Information -->
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 48px; height: 48px; background: #CFFAFE; color: #0E7490;">
                            <i class="bi bi-clipboard2-pulse fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Patient Information</h5>
                            <p class="cn-muted small mb-0">
                                Basic demographic and contact details.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold">
                                Date of Birth
                            </label>
                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />
                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold">
                                Gender
                            </label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BloodGroup" class="form-label fw-semibold">
                                Blood Group
                            </label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">Select blood group</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                            <span asp-validation-for="BloodGroup"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">
                                Address
                            </label>
                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter patient's address"
                                      autocomplete="street-address"></textarea>
                            <span asp-validation-for="Address"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Patients"
                           class="btn btn-outline-secondary rounded-3 px-4">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-gradient rounded-3 px-4">
                            <i class="bi bi-person-plus me-2"></i>
                            Create Patient
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Information Sidebar -->
        <div class="col-lg-4">
            <div class="cn-card p-4 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 44px; height: 44px; background: #DBEAFE; color: #1D4ED8;">
                        <i class="bi bi-info-circle fs-5"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Before You Create</h5>
                </div>

                <ul class="list-unstyled mb-0">
                    <li class="d-flex gap-2 mb-3">
                        <i class="bi bi-check-circle-fill text-primary mt-1"></i>
                        <span class="cn-muted">
                            Verify the patient's name and email address.
                        </span>
                    </li>
                    <li class="d-flex gap-2 mb-3">
                        <i class="bi bi-check-circle-fill text-primary mt-1"></i>
                        <span class="cn-muted">
                            Use a strong initial password and follow your account setup policy.
                        </span>
                    </li>
                    <li class="d-flex gap-2">
                        <i class="bi bi-check-circle-fill text-primary mt-1"></i>
                        <span class="cn-muted">
                            Enter only patient information needed for clinic operations.
                        </span>
                    </li>
                </ul>
            </div>

            <div class="rounded-4 p-4"
                 style="background: linear-gradient(135deg, #102A56, #1D4ED8); color: white;">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <i class="bi bi-shield-lock fs-2"></i>
                    <h5 class="fw-bold mb-0">Account Security</h5>
                </div>

                <p class="mb-0 small" style="color: #DBEAFE;">
                    Patient accounts should be created securely. Never store passwords as plain text, and use ASP.NET Core Identity to manage credentials.
                </p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}