@model IEnumerable<ClinicNexa.Web.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Manage Users";

    var users = Model?.ToList()
        ?? new List<ClinicNexa.Web.ViewModels.AdminUserViewModel>();

    var usersWithRoles = users.Count(u => u.Roles?.Any() == true);
    var usersWithoutRoles = users.Count - usersWithRoles;
    var totalRoleAssignments = users.Sum(u => u.Roles?.Count ?? 0);
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="cn-hero p-4 p-lg-5 mb-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3">

            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="cn-glass rounded-circle p-2">
                        <i class="bi bi-people fs-4"></i>
                    </span>
                    <span class="text-uppercase small fw-semibold">
                        Administration
                    </span>
                </div>

                <h1 class="cn-page-title mb-2">Manage Users</h1>
                <p class="cn-muted mb-0">
                    View registered users and review their assigned roles.
                </p>
            </div>

            <a asp-action="Dashboard"
               class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Dashboard
            </a>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Total Users</div>
                        <h3 class="fw-bold mb-0">@users.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Users With Roles</div>
                        <h3 class="fw-bold mb-0">@usersWithRoles</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-person-exclamation fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Users Without Roles</div>
                        <h3 class="fw-bold mb-0">@usersWithoutRoles</h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Users Table -->
    <div class="cn-card overflow-hidden">

        <div class="p-4 border-bottom">
            <div class="d-flex flex-column flex-sm-row
                        justify-content-between align-items-sm-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Registered Users</h5>
                    <p class="cn-muted small mb-0">
                        User account and role overview.
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-primary px-3 py-2">
                    @users.Count users
                </span>
            </div>
        </div>

        @if (users.Count == 0)
        {
            <div class="text-center py-5 px-3">
                <i class="bi bi-person-lines-fill display-5 cn-muted"></i>
                <h5 class="fw-bold mt-3">No users found</h5>
                <p class="cn-muted mb-0">
                    Registered users will appear here.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">User</th>
                            <th>Email Address</th>
                            <th>Assigned Roles</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in users)
                        {
                            var fullName = string.IsNullOrWhiteSpace(user.FullName)
                            ? "-"
                            : user.FullName;

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center
                                                            justify-content-center bg-primary
                                                            bg-opacity-10 text-primary fw-bold
                                                            flex-shrink-0"
                                             style="width: 42px; height: 42px;">
                                            @if (!string.IsNullOrWhiteSpace(user.FullName))
                                            {
                                                @user.FullName.Trim().FirstOrDefault()
                                            }
                                            else
                                            {
                                                <i class="bi bi-person"></i>
                                            }
                                    </div>

                                    <span class="fw-semibold">@fullName</span>
                                </div>
                            </td>

                            <td>
                                <span class="text-break">
                                    @(string.IsNullOrWhiteSpace(user.Email)
                                                                    ? "-"
                                                                    : user.Email)
                            </span>
                        </td>

                                <td>
                            @if (user.Roles?.Any() == true)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
                                                    <i class="bi bi-shield-check me-1"></i>@role
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                                            <i class="bi bi-dash-circle me-1"></i>No role assigned
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

        <div class="px-4 py-3 border-top">
            <span class="cn-muted small">
                Showing @users.Count user(s)
                <span class="mx-1">·</span>
                @totalRoleAssignments role assignment(s)
            </span>
        </div>

    </div>
</div>