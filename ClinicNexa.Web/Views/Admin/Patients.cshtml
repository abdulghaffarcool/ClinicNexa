@model IEnumerable<ClinicNexa.Web.Models.Patient>

@{
    ViewData["Title"] = "Patients";

    var patients = Model?.ToList()
        ?? new List<ClinicNexa.Web.Models.Patient>();

    var activeCount = patients.Count(p => p.IsActive);
    var inactiveCount = patients.Count(p => !p.IsActive);
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="cn-hero p-4 p-lg-5 mb-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3">

            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="cn-glass rounded-circle p-2">
                        <i class="bi bi-people fs-4"></i>
                    </span>
                    <span class="text-uppercase small fw-semibold">
                        Patient Management
                    </span>
                </div>

                <h1 class="cn-page-title mb-2">Patients</h1>
                <p class="cn-muted mb-0">
                    Manage registered patients, review profiles, and maintain account status.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Dashboard"
                   class="btn btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-2"></i>Dashboard
                </a>

                <a asp-action="CreatePatient"
                   class="btn btn-gradient rounded-pill px-4">
                    <i class="bi bi-person-plus me-2"></i>Add Patient
                </a>
            </div>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Total Patients</div>
                        <h3 class="fw-bold mb-0">@patients.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Active Patients</div>
                        <h3 class="fw-bold mb-0">@activeCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-person-x fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Inactive Patients</div>
                        <h3 class="fw-bold mb-0">@inactiveCount</h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Patients Table -->
    <div class="cn-card overflow-hidden">

        <div class="p-4 border-bottom">
            <div class="d-flex flex-column flex-sm-row
                        justify-content-between align-items-sm-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Registered Patients</h5>
                    <p class="cn-muted small mb-0">
                        View and manage patient accounts.
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-primary px-3 py-2">
                    @patients.Count patients
                </span>
            </div>
        </div>

        @if (patients.Count == 0)
        {
            <div class="text-center py-5 px-3">
                <i class="bi bi-people display-5 cn-muted"></i>
                <h5 class="fw-bold mt-3">No patients found</h5>
                <p class="cn-muted mb-3">
                    Add a patient to get started.
                </p>
                <a asp-action="CreatePatient"
                   class="btn btn-gradient rounded-pill px-4">
                    <i class="bi bi-person-plus me-2"></i>Add Patient
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">Patient</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Gender</th>
                            <th class="text-center">Appointments</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var patient in patients)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center
                                                            justify-content-center bg-primary bg-opacity-10
                                                            text-primary fw-bold flex-shrink-0"
                                             style="width: 42px; height: 42px;">
                                            @patient.FirstName?.FirstOrDefault()@patient.LastName?.FirstOrDefault()
                                        </div>

                                        <div>
                                            <div class="fw-semibold">
                                                @patient.FirstName @patient.LastName
                                            </div>
                                            <div class="cn-muted small">
                                                Patient ID: @patient.Id
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="text-break">
                                        @(patient.User?.Email ?? "-")
                                    </span>
                                </td>

                                <td class="text-nowrap">
                                    @(patient.Phone ?? "-")
                                </td>

                                <td>
                                    @(patient.Gender ?? "-")
                                </td>

                                <td class="text-center">
                                    <span class="badge rounded-pill bg-info bg-opacity-10 text-info px-3 py-2">
                                        @(patient.Appointments?.Count ?? 0)
                                    </span>
                                </td>

                                <td>
                                    @if (patient.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                                            <i class="bi bi-pause-circle me-1"></i>Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-1">

                                        <a asp-action="PatientDetails"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View patient details"
                                           aria-label="View patient details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="EditPatient"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit patient"
                                           aria-label="Edit patient">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="ResetPassword"
                                           asp-route-type="Patient"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Reset password"
                                           aria-label="Reset patient password">
                                            <i class="bi bi-key"></i>
                                        </a>

                                        <form asp-action="TogglePatient"
                                              asp-route-id="@patient.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            @if (patient.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Deactivate patient"
                                                        aria-label="Deactivate patient"
                                                        onclick="return confirm('Are you sure you want to deactivate this patient?');">
                                                    <i class="bi bi-person-x"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Activate patient"
                                                        aria-label="Activate patient">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            }

                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

        <div class="px-4 py-3 border-top">
            <span class="cn-muted small">
                Showing @patients.Count patient(s)
            </span>
        </div>

    </div>
</div>