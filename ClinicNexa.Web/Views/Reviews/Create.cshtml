@model ClinicNexa.Web.ViewModels.ReviewViewModel

@{
    ViewData["Title"] = "Leave a Review";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-1">Leave a Review</h3>

                    <p class="text-muted mb-4">
                        Review your appointment with
                        <strong>@ViewBag.DoctorName</strong>
                    </p>

                    <div class="mb-4">
                        <small class="text-muted">
                            Appointment Date
                        </small>

                        <div class="fw-semibold">
                            @(((DateTime)ViewBag.AppointmentDate).ToString("dd MMM yyyy"))
                        </div>
                    </div>

                    <form asp-action="Create" method="post">

                        <input asp-for="AppointmentId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Rating
                            </label>

                            <div class="d-flex gap-2">

                                @for (int i = 1; i <= 5; i++)
                                {
                                    <div>
                                        <input type="radio"
                                               class="btn-check"
                                               asp-for="Rating"
                                               value="@i"
                                               id="rating_@i" />

                                        <label class="btn btn-outline-warning"
                                               for="rating_@i">
                                            @i ★
                                        </label>
                                    </div>
                                }

                            </div>

                            <span asp-validation-for="Rating"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Comment"
                                   class="form-label fw-semibold">
                                Comment
                            </label>

                            <textarea asp-for="Comment"
                                      class="form-control"
                                      rows="5"
                                      maxlength="1000"
                                      placeholder="Share your experience...">
                            </textarea>

                            <span asp-validation-for="Comment"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Patient"
                               asp-action="Appointments"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-star"></i>
                                Submit Review
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}