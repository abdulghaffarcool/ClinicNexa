@{
    ViewData["Title"] = "About Us";
}

<!-- Page Hero -->
<section class="cn-hero mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="badge rounded-pill bg-white text-primary px-3 py-2 mb-4">
                <i class="bi bi-heart-pulse-fill me-2"></i>
                About ClinicNexa
            </span>

            <h1 class="display-4 fw-bold mb-4">
                Making healthcare
                <span style="color: #67E8F9;">simpler.</span>
            </h1>

            <p class="lead mb-0" style="max-width: 700px;">
                ClinicNexa is a modern doctor appointment platform
                designed to make discovering healthcare professionals
                and managing appointments easier and more convenient.
            </p>
        </div>

        <div class="col-lg-4 text-center">
            <div class="cn-glass p-4">
                <i class="bi bi-hospital"
                   style="font-size: 5rem; color: #67E8F9;"></i>
                <h2 class="h4 fw-bold mt-3 mb-2">Care starts here</h2>
                <p class="mb-0">
                    A simpler way to connect with healthcare professionals.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Our Purpose -->
<section class="mb-5">
    <div class="row g-4 align-items-center">
        <div class="col-lg-6">
            <span class="text-primary fw-semibold small text-uppercase">
                OUR PURPOSE
            </span>

            <h2 class="cn-page-title mt-2 mb-3">
                Healthcare appointments, made easier
            </h2>

            <p class="cn-muted">
                Finding the right doctor and arranging an appointment
                should be straightforward. ClinicNexa brings essential
                appointment-related information together in one place.
            </p>

            <p class="cn-muted mb-0">
                Patients can explore doctor profiles and available
                schedules, while doctors can manage their professional
                profiles and appointment schedules through a dedicated
                interface.
            </p>
        </div>

        <div class="col-lg-6">
            <div class="cn-card p-4 p-md-5">
                <div class="d-flex gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0"
                         style="width: 50px; height: 50px; background: #dbeafe; color: #1d4ed8;">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>

                    <div>
                        <h3 class="h5 fw-bold">For Patients</h3>
                        <p class="cn-muted mb-0">
                            Discover doctors, manage appointments,
                            and maintain your patient profile.
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0"
                         style="width: 50px; height: 50px; background: #cffafe; color: #0e7490;">
                        <i class="bi bi-calendar2-check fs-4"></i>
                    </div>

                    <div>
                        <h3 class="h5 fw-bold">For Doctors</h3>
                        <p class="cn-muted mb-0">
                            Maintain professional profiles, manage
                            schedules, and oversee appointments.
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0"
                         style="width: 50px; height: 50px; background: #e0e7ff; color: #4338ca;">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>

                    <div>
                        <h3 class="h5 fw-bold">For Administrators</h3>
                        <p class="cn-muted mb-0">
                            Manage platform users, doctor records,
                            specialties, and appointment information.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Values -->
<section class="mb-5 py-3">
    <div class="text-center mb-5">
        <span class="badge rounded-pill bg-white text-primary border px-3 py-2 mb-3">
            WHAT GUIDES US
        </span>

        <h2 class="cn-page-title display-6 mb-3">
            Built around a better experience
        </h2>

        <p class="cn-muted mx-auto" style="max-width: 650px;">
            Our approach focuses on making everyday appointment
            management clear, accessible, and convenient.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="cn-card h-100 p-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-4"
                     style="width: 58px; height: 58px; background: #dbeafe; color: #1d4ed8;">
                    <i class="bi bi-hand-thumbs-up fs-3"></i>
                </div>

                <h3 class="h5 fw-bold mb-3">Simplicity</h3>

                <p class="cn-muted mb-0">
                    Straightforward navigation and focused features
                    help users complete common tasks with less friction.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cn-card h-100 p-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-4"
                     style="width: 58px; height: 58px; background: #cffafe; color: #0e7490;">
                    <i class="bi bi-people fs-3"></i>
                </div>

                <h3 class="h5 fw-bold mb-3">Accessibility</h3>

                <p class="cn-muted mb-0">
                    Responsive interfaces help patients, doctors,
                    and administrators use the platform across devices.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cn-card h-100 p-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-4"
                     style="width: 58px; height: 58px; background: #e0e7ff; color: #4338ca;">
                    <i class="bi bi-layout-text-window-reverse fs-3"></i>
                </div>

                <h3 class="h5 fw-bold mb-3">Organization</h3>

                <p class="cn-muted mb-0">
                    Dedicated dashboards and schedule management
                    help keep appointment-related tasks organized.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Closing CTA -->
<section class="cn-card overflow-hidden mb-4">
    <div class="p-4 p-md-5 text-center">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
             style="width: 72px; height: 72px; background: #dbeafe; color: #1d4ed8;">
            <i class="bi bi-search-heart fs-1"></i>
        </div>

        <h2 class="cn-page-title mb-3">
            Start with the right doctor
        </h2>

        <p class="cn-muted mx-auto mb-4" style="max-width: 600px;">
            Explore doctor profiles and find a suitable appointment
            through ClinicNexa.
        </p>

        <a asp-controller="Doctors"
           asp-action="Index"
           class="btn btn-primary btn-lg">
            Find a Doctor
            <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
</section>