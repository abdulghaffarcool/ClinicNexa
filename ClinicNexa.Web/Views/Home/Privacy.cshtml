@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-4 py-lg-5">

    <!-- Hero -->
    <div class="cn-hero p-4 p-lg-5 mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge rounded-pill bg-white text-primary px-3 py-2 mb-3">
                    <i class="bi bi-shield-check me-1"></i>
                    Your Privacy Matters
                </span>

                <h1 class="display-6 fw-bold text-white mb-3">
                    Privacy Policy
                </h1>

                <p class="text-white opacity-75 mb-0">
                    Learn how ClinicNexa handles personal information when you use our appointment booking and patient portal services.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end">
                <i class="bi bi-shield-lock text-white"
                   style="font-size: 6rem; opacity: 0.85;"></i>
            </div>
        </div>
    </div>

    <!-- Intro -->
    <div class="cn-card p-4 p-lg-5 mb-4">
        <div class="d-flex align-items-start gap-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width: 52px; height: 52px; background: #DBEAFE;">
                <i class="bi bi-info-circle text-primary fs-3"></i>
            </div>

            <div>
                <h2 class="cn-page-title mb-2">Introduction</h2>
                <p class="cn-muted mb-0">
                    ClinicNexa is a doctor appointment management system designed to help patients discover doctors, book appointments, and manage their profiles. This policy explains the types of information the application may handle, how that information may be used, and the steps intended to protect it.
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Main Content -->
        <div class="col-lg-8">

            <!-- Information Collected -->
            <div class="cn-card p-4 p-lg-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #DBEAFE;">
                        <i class="bi bi-person-lines-fill text-primary fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">1. Information We Collect</h2>
                </div>

                <p class="cn-muted">
                    Depending on the features you use, ClinicNexa may process the following information:
                </p>

                <ul class="cn-muted mb-0">
                    <li class="mb-2">
                        <strong>Account information:</strong>
                        Name, email address, and account credentials managed through the authentication system.
                    </li>
                    <li class="mb-2">
                        <strong>Patient profile:</strong>
                        Date of birth, gender, phone number, address, and blood group when provided.
                    </li>
                    <li class="mb-2">
                        <strong>Appointment information:</strong>
                        Selected doctor, appointment date and time, booking status, and reason for the visit when provided.
                    </li>
                    <li class="mb-2">
                        <strong>Reviews and feedback:</strong>
                        Ratings and comments submitted through available review features.
                    </li>
                    <li>
                        <strong>Technical information:</strong>
                        Limited information generated during application operation, such as diagnostic logs, where configured.
                    </li>
                </ul>
            </div>

            <!-- How Information Is Used -->
            <div class="cn-card p-4 p-lg-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #CFFAFE;">
                        <i class="bi bi-gear text-info fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">2. How We Use Information</h2>
                </div>

                <p class="cn-muted">
                    Information may be used to:
                </p>

                <ul class="cn-muted mb-0">
                    <li class="mb-2">Create and manage user accounts.</li>
                    <li class="mb-2">Display doctor profiles and available appointment schedules.</li>
                    <li class="mb-2">Create, manage, and track appointment bookings.</li>
                    <li class="mb-2">Maintain patient profiles and display submitted reviews.</li>
                    <li class="mb-2">Maintain application security and troubleshoot technical problems.</li>
                    <li>Improve application functionality and user experience.</li>
                </ul>
            </div>

            <!-- Health Information -->
            <div class="cn-card p-4 p-lg-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #F3E8FF;">
                        <i class="bi bi-heart-pulse text-primary fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">3. Health-Related Information</h2>
                </div>

                <p class="cn-muted mb-0">
                    Information such as blood group and appointment reasons may be sensitive. Please provide only information necessary for using the service. ClinicNexa's appointment management features are not a substitute for a medical record system or emergency medical services. Access to sensitive information should be restricted to authorized users according to their roles and permissions.
                </p>
            </div>

            <!-- Sharing -->
            <div class="cn-card p-4 p-lg-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #DBEAFE;">
                        <i class="bi bi-people text-primary fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">4. Information Sharing</h2>
                </div>

                <p class="cn-muted">
                    Personal information should only be accessible to people who need it for legitimate system operations. Depending on assigned roles and application functionality, relevant information may be available to:
                </p>

                <ul class="cn-muted mb-3">
                    <li class="mb-2">The patient who owns the account.</li>
                    <li class="mb-2">Authorized doctors who need relevant appointment details.</li>
                    <li>Authorized administrators responsible for managing the system.</li>
                </ul>

                <p class="cn-muted mb-0">
                    Information may also need to be disclosed when required by applicable law. Any third-party hosting, email, analytics, or other service providers should be disclosed here if the deployed application uses them.
                </p>
            </div>

            <!-- Security -->
            <div class="cn-card p-4 p-lg-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #D1FAE5;">
                        <i class="bi bi-shield-lock text-success fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">5. Data Security</h2>
                </div>

                <p class="cn-muted mb-0">
                    ClinicNexa is intended to use appropriate safeguards to protect personal information against unauthorized access, loss, misuse, or alteration. Such safeguards may include authentication, role-based authorization, secure password handling, HTTPS, and controlled database access. No method of storage or transmission can be guaranteed to be completely secure.
                </p>
            </div>

            <!-- Retention -->
            <div class="cn-card p-4 p-lg-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #FEF3C7;">
                        <i class="bi bi-database text-warning fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">6. Data Retention</h2>
                </div>

                <p class="cn-muted mb-0">
                    Information should be retained only for as long as necessary for the purposes described in this policy, subject to applicable legal, operational, and recordkeeping requirements. Actual retention periods and deletion procedures depend on the deployed system's configuration and policies.
                </p>
            </div>

            <!-- User Rights -->
            <div class="cn-card p-4 p-lg-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #E0E7FF;">
                        <i class="bi bi-person-check text-primary fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">7. Your Privacy Choices</h2>
                </div>

                <p class="cn-muted">
                    Subject to applicable law and legitimate recordkeeping requirements, you may be able to:
                </p>

                <ul class="cn-muted mb-0">
                    <li class="mb-2">Review and update your patient profile.</li>
                    <li class="mb-2">Request access to personal information associated with your account.</li>
                    <li class="mb-2">Request correction or deletion of eligible information.</li>
                    <li>Ask questions about how your information is handled.</li>
                </ul>
            </div>

            <!-- Cookies -->
            <div class="cn-card p-4 p-lg-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #CFFAFE;">
                        <i class="bi bi-window text-info fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">8. Cookies and Sessions</h2>
                </div>

                <p class="cn-muted mb-0">
                    The application may use cookies or similar technologies to support sign-in, maintain user sessions, and provide essential functionality. The cookies actually used depend on the application's configuration and any additional services enabled.
                </p>
            </div>

            <!-- Policy Updates -->
            <div class="cn-card p-4 p-lg-5">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 48px; height: 48px; background: #DBEAFE;">
                        <i class="bi bi-arrow-repeat text-primary fs-4"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-0">9. Changes to This Policy</h2>
                </div>

                <p class="cn-muted mb-0">
                    This policy may be updated as ClinicNexa's features, data practices, or legal obligations change. The latest version should be published on this page with its effective date.
                </p>
            </div>

        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">

            <div class="cn-card p-4 mb-4">
                <div class="rounded-3 d-flex align-items-center justify-content-center mb-3"
                     style="width: 54px; height: 54px; background: #DBEAFE;">
                    <i class="bi bi-lock text-primary fs-3"></i>
                </div>

                <h5 class="fw-bold mb-2">Privacy by Design</h5>

                <p class="cn-muted mb-0">
                    Personal information should be collected only when needed and made available only to appropriately authorized users.
                </p>
            </div>

            <div class="cn-card p-4 mb-4">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-list-check text-info me-2"></i>
                    At a Glance
                </h5>

                <ul class="list-unstyled cn-muted mb-0">
                    <li class="d-flex gap-2 mb-3">
                        <i class="bi bi-check-circle-fill text-primary mt-1"></i>
                        <span>Account and profile information</span>
                    </li>

                    <li class="d-flex gap-2 mb-3">
                        <i class="bi bi-check-circle-fill text-primary mt-1"></i>
                        <span>Appointment and review management</span>
                    </li>

                    <li class="d-flex gap-2 mb-3">
                        <i class="bi bi-check-circle-fill text-primary mt-1"></i>
                        <span>Role-based access where configured</span>
                    </li>

                    <li class="d-flex gap-2">
                        <i class="bi bi-check-circle-fill text-primary mt-1"></i>
                        <span>Options to review and correct eligible information</span>
                    </li>
                </ul>
            </div>

            <div class="cn-card p-4"
                 style="background: #EAF2FF;">
                <i class="bi bi-chat-square-text text-primary fs-3 mb-3"></i>

                <h5 class="fw-bold mb-2">Privacy Questions?</h5>

                <p class="cn-muted mb-0">
                    If you have questions or requests concerning your personal information, contact the clinic or the administrator responsible for your ClinicNexa deployment.
                </p>
            </div>

        </div>
    </div>

    <!-- Footer Note -->
    <div class="text-center mt-5 pt-3">
        <i class="bi bi-shield-check text-primary fs-4"></i>
        <p class="cn-muted small mt-2 mb-0">
            ClinicNexa · Privacy and responsible information handling
        </p>
    </div>

</div>