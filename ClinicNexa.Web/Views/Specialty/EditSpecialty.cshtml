@model ClinicNexa.Web.Models.Specialty

@{
    ViewData["Title"] = "Edit Specialty";
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge rounded-pill px-3 py-2 mb-2"
                  style="background: #DBEAFE; color: #1D4ED8;">
                <i class="bi bi-heart-pulse me-1"></i>
                Specialty Management
            </span>

            <h2 class="cn-page-title mb-2">Edit Specialty</h2>
            <p class="cn-muted mb-0">
                Update the specialty name and description used in the clinic directory.
            </p>
        </div>

        <a asp-action="Specialties"
           class="btn btn-outline-primary rounded-3">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Specialties
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="cn-card p-4 p-lg-5">

                <!-- Form Heading -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 54px; height: 54px; background: #DBEAFE; color: #1D4ED8;">
                        <i class="bi bi-clipboard2-pulse fs-3"></i>
                    </div>

                    <div>
                        <h4 class="fw-bold mb-1">Specialty Details</h4>
                        <p class="cn-muted small mb-0">
                            Make the necessary changes and save your updates.
                        </p>
                    </div>
                </div>

                <form asp-action="EditSpecialty" method="post">
                    @Html.AntiForgeryToken()

                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger rounded-3"
                         role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold">
                            Specialty Name
                        </label>

                        <input asp-for="Name"
                               class="form-control form-control-lg"
                               placeholder="e.g. Cardiology"
                               autocomplete="off" />

                        <span asp-validation-for="Name"
                              class="text-danger small"></span>

                        <div class="form-text">
                            Use a clear and recognizable medical specialty name.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe this medical specialty and the type of care it covers."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small"></span>

                        <div class="form-text">
                            Keep the description concise and helpful for patients.
                        </div>
                    </div>

                    <div class="rounded-3 p-3 mb-4"
                         style="background: #EFF6FF; border: 1px solid #DBEAFE;">
                        <div class="d-flex gap-3">
                            <i class="bi bi-info-circle-fill fs-5"
                               style="color: #1D4ED8;"></i>

                            <div>
                                <div class="fw-semibold mb-1"
                                     style="color: #1E40AF;">
                                    Maintain consistent naming
                                </div>
                                <p class="small mb-0"
                                   style="color: #526783;">
                                    Avoid duplicate specialty names to keep doctor listings and patient searches organized.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Specialties"
                           class="btn btn-outline-secondary rounded-3 px-4">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-gradient rounded-3 px-4">
                            <i class="bi bi-save me-2"></i>
                            Save Changes
                        </button>
                    </div>

                </form>
            </div>

            <p class="text-center cn-muted small mt-3 mb-0">
                <i class="bi bi-shield-check me-1"></i>
                Only authorized administrators should manage medical specialties.
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}