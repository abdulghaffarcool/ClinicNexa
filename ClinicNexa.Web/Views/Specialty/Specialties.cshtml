@model IEnumerable<ClinicNexa.Web.Models.Specialty>

@{
    ViewData["Title"] = "Manage Specialties";

    var specialties = Model?.ToList()
        ?? new List<ClinicNexa.Web.Models.Specialty>();

    var totalDoctors = specialties.Sum(s => s.DoctorSpecialties?.Count ?? 0);
    var unusedCount = specialties.Count(s =>
        s.DoctorSpecialties == null || !s.DoctorSpecialties.Any());
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="cn-hero p-4 p-lg-5 mb-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3">

            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="cn-glass rounded-circle p-2">
                        <i class="bi bi-heart-pulse fs-4"></i>
                    </span>
                    <span class="text-uppercase small fw-semibold">
                        Clinic Configuration
                    </span>
                </div>

                <h1 class="cn-page-title mb-2">Manage Specialties</h1>
                <p class="cn-muted mb-0">
                    Manage the medical specialties available in ClinicNexa.
                </p>
            </div>

            <a asp-action="CreateSpecialty"
               class="btn btn-gradient rounded-pill px-4">
                <i class="bi bi-plus-lg me-2"></i>Add Specialty
            </a>

        </div>
    </div>
        
    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-heart-pulse fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Total Specialties</div>
                        <h3 class="fw-bold mb-0">@specialties.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Doctor Assignments</div>
                        <h3 class="fw-bold mb-0">@totalDoctors</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="cn-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-inbox fs-4"></i>
                    </div>
                    <div>
                        <div class="cn-muted small">Unused Specialties</div>
                        <h3 class="fw-bold mb-0">@unusedCount</h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Specialties Table -->
    <div class="cn-card overflow-hidden">

        <div class="p-4 border-bottom">
            <div class="d-flex flex-column flex-sm-row
                        justify-content-between align-items-sm-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Medical Specialties</h5>
                    <p class="cn-muted small mb-0">
                        Edit specialty information or remove unused specialties.
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-primary px-3 py-2">
                    @specialties.Count specialties
                </span>
            </div>
        </div>

        @if (specialties.Count == 0)
        {
            <div class="text-center py-5 px-3">
                <i class="bi bi-clipboard2-pulse display-5 cn-muted"></i>
                <h5 class="fw-bold mt-3">No specialties found</h5>
                <p class="cn-muted mb-3">
                    Add a specialty to start organizing your doctors.
                </p>
                <a asp-action="CreateSpecialty"
                   class="btn btn-gradient rounded-pill px-4">
                    <i class="bi bi-plus-lg me-2"></i>Add Specialty
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">Specialty</th>
                            <th>Description</th>
                            <th class="text-center">Doctors</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var specialty in specialties)
                        {
                            var doctorCount = specialty.DoctorSpecialties?.Count ?? 0;

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 d-flex align-items-center
                                                            justify-content-center bg-primary
                                                            bg-opacity-10 text-primary flex-shrink-0"
                                             style="width: 44px; height: 44px;">
                                            <i class="bi bi-heart-pulse fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">
                                                @specialty.Name
                                            </div>
                                            <div class="cn-muted small">
                                                ID: @specialty.Id
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(specialty.Description))
                                    {
                                        <span class="cn-muted fst-italic">
                                            No description provided
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@specialty.Description</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (doctorCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
                                            <i class="bi bi-people me-1"></i>@doctorCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                                            0 doctors
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-2">

                                        <a asp-action="EditSpecialty"
                                           asp-route-id="@specialty.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit specialty">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>

                                        @if (doctorCount == 0)
                                        {
                                            <form asp-action="DeleteSpecialty"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@specialty.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete specialty"
                                                        onclick="return confirm('Delete this specialty?');">
                                                    <i class="bi bi-trash me-1"></i>Delete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    disabled
                                                    title="Remove all doctor assignments before deleting">
                                                <i class="bi bi-lock me-1"></i>Delete
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

        <div class="px-4 py-3 border-top">
            <span class="cn-muted small">
                Showing @specialties.Count specialty/specialties
            </span>
        </div>

    </div>
</div>