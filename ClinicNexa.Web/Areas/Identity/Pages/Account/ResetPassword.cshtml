@page
@model ClinicNexa.Web.Areas.Identity.Pages.Account.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="cn-card p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width: 76px; height: 76px; background: #DBF7FF; color: #1D4ED8;">
                        <i class="bi bi-shield-lock" style="font-size: 2.25rem;"></i>
                    </div>

                    <h2 class="fw-bold mb-2" style="color: #102A56;">
                        Reset Password
                    </h2>

                    <p class="cn-muted mb-0">
                        Choose a strong new password to secure your ClinicNexa account.
                    </p>
                </div>

                <div class="rounded-3 p-3 mb-4"
                     style="background: #EFF6FF; border: 1px solid #CBDCF5;">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                        <small class="cn-muted">
                            Enter your new password and confirm it below.
                        </small>
                    </div>
                </div>

                <form method="post">
                    <input asp-for="Input.Code" type="hidden" />
                    <input asp-for="Input.Email" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3"
                         role="alert">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold">
                            New Password
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-lock text-primary"></i>
                            </span>

                            <input asp-for="Input.Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Enter new password" />
                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">
                            Confirm New Password
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-shield-check text-primary"></i>
                            </span>

                            <input asp-for="Input.ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Re-enter new password" />
                        </div>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger small">
                        </span>
                    </div>

                    <button type="submit" class="btn btn-gradient w-100 py-2 fw-semibold">
                        <i class="bi bi-check-circle me-2"></i>
                        Reset Password
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-page="./Login" class="text-decoration-none fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Login
                    </a>
                </div>

                <div class="text-center mt-4 pt-3 border-top">
                    <small class="cn-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Your account security matters to us.
                    </small>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}