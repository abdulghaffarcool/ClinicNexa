@page
@model ClinicNexa.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-8 col-lg-5 col-xl-4">

            <!-- Login Header -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center
                            justify-content-center rounded-4
                            bg-primary bg-opacity-10 text-primary mb-3"
                     style="width: 72px; height: 72px;">
                    <i class="bi bi-hospital fs-1"></i>
                </div>

                <h1 class="fw-bold mb-2">Welcome Back</h1>
                <p class="cn-muted mb-0">
                    Sign in to your ClinicNexa account.
                </p>
            </div>

            <!-- Login Card -->
            <div class="cn-card p-4 p-lg-5">

                <div class="mb-4">
                    <h4 class="fw-bold mb-1">Login</h4>
                    <p class="cn-muted small mb-0">
                        Enter your credentials to continue.
                    </p>
                </div>

                <form method="post">

                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger rounded-3 mb-4"
                         role="alert"></div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Input.Email"
                               class="form-label fw-semibold">
                            Email Address
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="you@example.com" />
                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Input.Password"
                               class="form-label fw-semibold">
                            Password
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" />
                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small"></span>
                    </div>

                    <!-- Remember Me / Forgot Password -->
                    <div class="d-flex flex-wrap justify-content-between
                                align-items-center gap-2 mb-4">

                        <div class="form-check">
                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />

                            <label asp-for="Input.RememberMe"
                                   class="form-check-label small">
                                Remember me
                            </label>
                        </div>

                        <a asp-page="./ForgotPassword"
                           class="small text-decoration-none fw-semibold">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="btn btn-gradient w-100 py-2 rounded-pill">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Sign In
                    </button>

                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <span class="cn-muted small">
                        Don't have an account?
                    </span>

                    <a asp-page="./Register"
                       class="fw-semibold text-decoration-none ms-1">
                        Create an account
                    </a>
                </div>

            </div>

            <p class="text-center cn-muted small mt-4">
                <i class="bi bi-shield-lock me-1"></i>
                Your account security matters to us.
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}