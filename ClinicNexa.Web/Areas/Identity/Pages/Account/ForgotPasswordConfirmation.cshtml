@page

@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-7 col-lg-5">

            <div class="cn-card p-4 p-md-5 text-center">

                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
                     style="width: 84px; height: 84px; background: #DBF7FF; color: #1D4ED8;">
                    <i class="bi bi-envelope-check" style="font-size: 2.5rem;"></i>
                </div>

                <h2 class="fw-bold mb-3" style="color: #102A56;">
                    Check Your Email
                </h2>

                <p class="cn-muted mb-4">
                    If an account exists for that email address, password reset instructions have been generated.
                    Please check your inbox and follow the instructions provided.
                </p>

                <div class="rounded-3 p-3 mb-4 text-start"
                     style="background: #EFF6FF; border: 1px solid #CBDCF5;">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                        <small style="color: #526783;">
                            If you don't see the email, check your spam or junk folder.
                        </small>
                    </div>
                </div>

                <a asp-page="./Login"
                   class="btn btn-gradient w-100 py-2 fw-semibold">
                    <i class="bi bi-arrow-left me-2"></i>
                    Back to Login
                </a>

                <div class="mt-4 pt-3 border-top">
                    <small class="cn-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Your account security matters to us.
                    </small>
                </div>

            </div>
        </div>
    </div>
</div>