@page
@model ClinicNexa.Web.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="cn-card p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width: 76px; height: 76px; background: #DBF7FF; color: #1D4ED8;">
                        <i class="bi bi-person-plus" style="font-size: 2.25rem;"></i>
                    </div>

                    <h2 class="fw-bold mb-2" style="color: #102A56;">
                        Create Your Account
                    </h2>

                    <p class="cn-muted mb-0">
                        Join ClinicNexa to manage your appointments and patient profile.
                    </p>
                </div>

                <div class="rounded-3 p-3 mb-4"
                     style="background: #EFF6FF; border: 1px solid #CBDCF5;">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-heart-pulse-fill text-primary fs-4"></i>
                        <div>
                            <div class="fw-semibold" style="color: #102A56;">Patient Registration</div>
                            <small class="cn-muted">Create your personal patient account.</small>
                        </div>
                    </div>
                </div>

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3"
                         role="alert">
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.FirstName" class="form-label fw-semibold">
                                First Name
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-person text-primary"></i>
                                </span>
                                <input asp-for="Input.FirstName"
                                       class="form-control"
                                       autocomplete="given-name"
                                       placeholder="First name" />
                            </div>

                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.LastName" class="form-label fw-semibold">
                                Last Name
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-person text-primary"></i>
                                </span>
                                <input asp-for="Input.LastName"
                                       class="form-control"
                                       autocomplete="family-name"
                                       placeholder="Last name" />
                            </div>

                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold">
                            Email Address
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-envelope text-primary"></i>
                            </span>
                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="you@example.com" />
                        </div>

                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold">
                            Password
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-lock text-primary"></i>
                            </span>
                            <input asp-for="Input.Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Create a password" />
                        </div>

                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">
                            Confirm Password
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-shield-lock text-primary"></i>
                            </span>
                            <input asp-for="Input.ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Re-enter your password" />
                        </div>

                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-gradient w-100 py-2 fw-semibold">
                        <i class="bi bi-person-check me-2"></i>
                        Create Account
                    </button>
                </form>

                <div class="text-center mt-4">
                    <span class="cn-muted">Already have an account?</span>
                    <a asp-page="./Login" class="text-decoration-none fw-semibold ms-1">
                        Sign In
                    </a>
                </div>

                <div class="text-center mt-4 pt-3 border-top">
                    <small class="cn-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Your account information is protected.
                    </small>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}