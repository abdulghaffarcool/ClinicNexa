@page

@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-7 col-lg-5">

            <div class="cn-card p-4 p-md-5 text-center">

                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
                     style="width: 84px; height: 84px; background: #DBF7FF; color: #1D4ED8;">
                    <i class="bi bi-check-circle-fill" style="font-size: 2.75rem;"></i>
                </div>

                <h2 class="fw-bold mb-3" style="color: #102A56;">
                    Password Reset Successful
                </h2>

                <p class="cn-muted mb-4">
                    Your password has been changed successfully. You can now sign in to ClinicNexa using your new password.
                </p>

                <div class="rounded-3 p-3 mb-4 text-start"
                     style="background: #EFF6FF; border: 1px solid #CBDCF5;">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-shield-check text-primary mt-1"></i>
                        <small class="cn-muted">
                            Keep your password private and never share it with anyone.
                        </small>
                    </div>
                </div>

                <a asp-page="./Login"
                   class="btn btn-gradient w-100 py-2 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Back to Login
                </a>

                <div class="text-center mt-4 pt-3 border-top">
                    <small class="cn-muted">
                        Thank you for choosing ClinicNexa.
                    </small>
                </div>

            </div>
        </div>
    </div>
</div>