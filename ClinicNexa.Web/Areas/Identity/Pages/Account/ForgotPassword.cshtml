@page
@model ClinicNexa.Web.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-7 col-lg-5">

            <div class="cn-card p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width: 76px; height: 76px; background: #DBF7FF; color: #1D4ED8;">
                        <i class="bi bi-shield-lock" style="font-size: 2rem;"></i>
                    </div>

                    <h2 class="fw-bold mb-2" style="color: #102A56;">
                        Forgot Password?
                    </h2>

                    <p class="cn-muted mb-0">
                        No worries. Enter your registered email address to get instructions for resetting your password.
                    </p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger mb-3"
                         role="alert">
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label fw-semibold">
                            Email Address
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-envelope text-primary"></i>
                            </span>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="email"
                                   autofocus
                                   placeholder="you@example.com" />
                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small">
                        </span>
                    </div>

                    <button type="submit" class="btn btn-gradient w-100 py-2 fw-semibold">
                        <i class="bi bi-send me-2"></i>
                        Reset Password
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-page="./Login"
                       class="text-decoration-none fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Login
                    </a>
                </div>

                <div class="text-center mt-4 pt-3 border-top">
                    <small class="cn-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Your account security matters to us.
                    </small>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}