@page
@model ClinicNexa.Web.Areas.Identity.Pages.Account.LogoutModel

@{
    ViewData["Title"] = "Logout";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-7 col-lg-5">

            <div class="cn-card p-4 p-md-5 text-center">

                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
                     style="width: 84px; height: 84px; background: #DBF7FF; color: #1D4ED8;">
                    <i class="bi bi-box-arrow-right" style="font-size: 2.5rem;"></i>
                </div>

                <h2 class="fw-bold mb-3" style="color: #102A56;">
                    Sign Out
                </h2>

                <p class="cn-muted mb-4">
                    Are you sure you want to sign out of your ClinicNexa account?
                </p>

                <form method="post">
                    <button type="submit"
                            class="btn btn-gradient w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Yes, Sign Out
                    </button>
                </form>

                <a asp-page="/Index"
                   class="btn btn-outline-primary w-100 mt-3 py-2">
                    Cancel
                </a>

            </div>
        </div>
    </div>
</div>